block partition(arr, low, high) {
    pivot = arr[high]
    i = low - 1
    j = low
    loop j < high {
        when arr[j] <= pivot {
            i += 1
            tmp = arr[i]
            arr[i] = arr[j]
            arr[j] = tmp
        }
        j += 1
    }
    tmp = arr[i + 1]
    arr[i + 1] = arr[high]
    arr[high] = tmp
    give i + 1
}


block quicksort(arr, low, high) {
    when low < high {
        pi = partition(arr, low, high)
        quicksort(arr, low, pi - 1)
        quicksort(arr, pi + 1, high)
    }
}


seed = 123456789
arr = []
loop k from 1..2000 {
    seed = (seed * 1103515245 + 12345) % 2147483648
    arr.add(seed % 100000)
}

start = clock()

quicksort(arr, 1, len(arr))

end = clock()


out("RESULT:", arr[1001])
out("TIME:", (end - start) * 1000.0)
