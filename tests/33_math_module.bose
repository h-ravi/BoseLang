/* Level 6 Math Module Comprehensive Verification Test */
out("=== 1. Basic Math ===")
fix m = math
out(m.abs(-42))
out(m.abs(42))
out(m.sign(-15))
out(m.sign(0))
out(m.sign(15))
out(m.min(10, 5, 20))
out(m.max(10, 5, 20))
out(m.round(3.7))
out(m.floor(3.7))
out(m.ceil(3.2))
out(m.clamp(15, 0, 10))
out(m.clamp(-5, 0, 10))
out(m.clamp(5, 0, 10))

out("=== 2. Power and Roots ===")
out(m.sqrt(16))
out(m.cbrt(27))
out(m.root(81, 4))
out(m.pow(2, 8))
out(m.log10(1000))
out(m.log2(64))

out("=== 3. Number Theory ===")
out(m.gcd(48, 18))
out(m.lcm(12, 18))
out(m.factorial(5))
out(m.combinations(5, 2))
out(m.permutations(5, 2))
out(m.is_prime(17))
out(m.is_prime(18))
out(m.factors(28))
out(m.primes(20))

out("=== 4. Statistics ===")
fix data = [10, 20, 20, 40, 50]
out(m.sum(data))
out(m.avg(data))
out(m.median(data))
out(m.mode(data))

out("=== 5. Trig, Constants & Geometry ===")
out(m.pi > 3.14 and m.pi < 3.15)
out(m.e > 2.71 and m.e < 2.72)
out(m.deg(m.rad(180)))
out(m.hypot(3, 4))
out(m.dist([0, 0], [3, 4]))
out(m.lerp(0, 100, 0.5))

out("=== 6. Bose Specials ===")
out(m.remap(50, 0, 100, 0, 1))
out(m.percent(25, 100))
out(m.percent_of(20, 200))
out(m.percent_change(100, 150))

out("=== All Math Tests Passed Successfully! ===")
