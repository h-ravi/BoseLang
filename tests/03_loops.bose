/* Test 03: Loops, Ranges, and Control Flow */
block auto main() {
    out("=== Test 03: Loops & Ranges ===")

    /* 1. Condition loop */
    n = 1
    sum = 0
    loop n <= 4 {
        sum += n
        n += 1
    }
    out("Sum of 1..4 is:", sum)

    /* 2. Inclusive range loop */
    out("Inclusive range 1..3:")
    loop i from 1..3 {
        out("  step:", i)
    }

    /* 3. Auto-reverse countdown 3..1 */
    out("Countdown 3..1:")
    loop i from 3..1 {
        out("  countdown:", i)
    }

    /* 4. Range with custom step */
    out("Step range 1..10..3:")
    loop i from 1..10..3 {
        out("  i:", i)
    }

    /* 5. Stop and Skip */
    out("Skip 2, Stop at 4:")
    loop i from 1..5 {
        when i == 2 {
            skip
        }
        when i == 4 {
            stop
        }
        out("  running:", i)
    }

    /* 6. Loop variable isolation */
    i = 999
    loop i from 1..2 {
        /* inner i */
    }
    out("Outer i remains 999:", i)
}
