block new_node(val) {
    node = {
        "val": val,
        "left": Null,
        "right": Null
    }
    give node
}

block insert(root, val) {
    when root == Null {
        give new_node(val)
    }
    when val < root["val"] {
        root["left"] = insert(root["left"], val)
    } again val > root["val"] {
        root["right"] = insert(root["right"], val)
    }
    give root
}

block in_order_sum(node) {
    when node == Null {
        give 0
    }
    left_sum = in_order_sum(node["left"])
    right_sum = in_order_sum(node["right"])
    give (left_sum + node["val"] + right_sum) % 1000000007
}

seed = 42
nums = []
loop i from 1..2000 {
    seed = (seed * 1103515245 + 12345) % 2147483648
    nums.add((seed % 10000) + 1)
}

start = clock()

root = Null
loop val from nums {
    root = insert(root, val)
}

checksum = in_order_sum(root)

end = clock()

out("RESULT:", checksum)
out("TIME:", (end - start) * 1000.0)
